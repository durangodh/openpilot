<?xml version="1.0" encoding="utf-8"?>
<!-- v0.13 : package / versionCode / minSdk / targetSdk 는 app/build.gradle 이 담당 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <queries>
        <package android:name="com.skt.tmap.ku" />
        <package android:name="com.nhn.android.nmap" />
        <package android:name="com.locnall.KimGiSa" />
        <package android:name="com.aa.nmirror" />
        <!-- 모듈 버전 확인(설치된 versionCode 를 읽는다) -->
        <package android:name="ai.comma.tmaphud" />
        <package android:name="ai.comma.naverhud" />
        <package android:name="ai.comma.kakaohud" />
        <!-- 음성 비서: 음성 인식·TTS 엔진 찾기(Android 11+ 패키지 공개 범위) -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="true" />

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Passive GPS source observation while the navigation app is foreground. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- v0.13: 화면 꺼짐/도즈 상태에서 렌더·전송 스레드 유지 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 리모컨 음성 비서(VoiceActivity 가 전경에서만 듣는다) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:allowBackup="false"
        android:label="EON Remote HUD"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".VoiceActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:launchMode="singleTask"
            android:taskAffinity=".voice"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".HudService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <provider
            android:name=".UpdateFileProvider"
            android:authorities="${applicationId}.updateprovider"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
