diff --git a/tinygrad/codegen/__init__.py b/tinygrad/codegen/__init__.py
index f4535a4..d73925e 100644
--- a/tinygrad/codegen/__init__.py
+++ b/tinygrad/codegen/__init__.py
@@ -514,6 +514,29 @@ def to_program_key(ast:UOp, renderer:Renderer) -> tuple:
   return (ast.key, type(renderer), renderer.target, *[x.value for x in to_program_config])
 
 to_program_cache: dict[tuple, UOp] = {}
+def _s20_pvtmem(prg:UOp, renderer:Renderer) -> int:
+  # private memory (register spill) of an IR3 shader; the a650 hangs on it with tinygrad's QCOM runtime
+  if type(renderer).__name__ != "IR3Renderer" or renderer.target.arch.split(",")[0] != "a650": return 0
+  from tinygrad.runtime.support.compiler_mesa import IR3Compiler
+  try: return IR3Compiler.unpack_lib(prg.src[-1].arg)[0].pvtmem_size
+  except Exception: return 0
+
+def _s20_to_program(ast:UOp, renderer:Renderer) -> UOp:
+  prg = do_to_program(ast, renderer)
+  if not _s20_pvtmem(prg, renderer) or ast.op is not Ops.SINK: return prg
+  # spilled: retry with fewer upcasts (fewer live registers), last with no optimizations at all
+  from tinygrad.codegen.opt import heuristic
+  for lim in (16, 8, 4, 2, 1):
+    heuristic.S20_UPCAST_LIMIT[0] = lim
+    try: prg = do_to_program(ast, renderer)
+    finally: heuristic.S20_UPCAST_LIMIT[0] = 1 << 30
+    if not _s20_pvtmem(prg, renderer):
+      if DEBUG >= 1: print(f"s20: {ast.arg.name if isinstance(ast.arg, KernelInfo) else '?'} spill avoided with upcast limit {lim}")
+      return prg
+  with Context(NOOPT=1): prg = do_to_program(ast, renderer)
+  if DEBUG >= 1: print(f"s20: {ast.arg.name if isinstance(ast.arg, KernelInfo) else '?'} NOOPT, private memory {_s20_pvtmem(prg, renderer)} B")
+  return prg
+
 def to_program(ast:UOp, renderer:Renderer) -> UOp:
-  if (prg:=to_program_cache.get(key:=to_program_key(ast, renderer))) is None: to_program_cache[key] = prg = do_to_program(ast, renderer)
+  if (prg:=to_program_cache.get(key:=to_program_key(ast, renderer))) is None: to_program_cache[key] = prg = _s20_to_program(ast, renderer)
   return prg
