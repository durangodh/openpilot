+    self.arch, self.dev_id = arch, (mesa.struct_fd_dev_id(630, 0x6030001) if gen == "a630" else mesa.struct_fd_dev_id(int(gen[1:]), 0))
     self.cc = mesa.ir3_compiler_create(None, self.dev_id, mesa.fd_dev_info(self.dev_id),
